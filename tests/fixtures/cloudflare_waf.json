      "headers": { "cf-ray": "abc130-SEA" },
      "body": "access denied"
    },
    {
      "key": "GET:/api/v1/status:",
      "status": 200,
      "headers": {},
      "body": "{\"status\":\"ok\"}"
    },
    {
      "key": "GET:/../../etc/passwd:",
      "status": 403,
      "headers": {},
      "body": "access denied"
    },
    {
      "key": "GET:/:cmd=list",
      "status": 200,
      "headers": {},
      "body": "<html>Command list</html>"
    },
    {
      "key": "GET:/:cmd=;cat+/etc/passwd",
      "status": 403,
      "headers": {},
      "body": "access denied"
    },
    {
      "key": "GET:/:format=json",
      "status": 200,
      "headers": {},
      "body": "{\"format\":\"json\"}"
    },
    {
      "key": "GET:/:format=../../etc/passwd%00.json",
      "status": 403,
      "headers": {},
      "body": "access denied"
    },
    {
      "key": "GET:/:va2=hdr1:H{Referer=https://example.com}",
      "status": 200,
      "headers": { "cf-ray": "abc131-SEA" },
      "body": "<html>Welcome to example.com</html>"
    },
    {
      "key": "GET:/:va2=hdr1:H{Referer=<script>alert(1)</script>}",
      "status": 403,
      "headers": { "cf-ray": "abc132-SEA" },
      "body": "access denied"
    },
    {
      "key": "GET:/:va2=hdr2:H{X-Search=test}",
