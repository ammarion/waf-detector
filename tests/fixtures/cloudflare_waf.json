      "headers": { "cf-ray": "abc134-SEA" },
      "body": "access denied"
    },
    {
      "key": "POST:/:va2=body1:H{Content-Type=application/x-www-form-urlencoded}:B{search=test}",
      "status": 200,
      "headers": { "cf-ray": "abc135-SEA" },
      "body": "<html>Search results</html>"
    },
    {
      "key": "POST:/:va2=body1:H{Content-Type=application/x-www-form-urlencoded}:B{search=1'+OR+'1'='1}",
      "status": 403,
      "headers": { "cf-ray": "abc136-SEA" },
      "body": "access denied"
    },
    {
