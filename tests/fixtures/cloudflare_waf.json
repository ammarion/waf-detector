{
  "name": "cloudflare_waf",
  "base_url": "https://example.com",
  "responses": [
    {
      "key": "GET:/:",
      "status": 200,
      "headers": { "cf-ray": "abc123-SEA", "server": "cloudflare" },
      "body": "<html>Welcome to example.com</html>"
    },
    {
      "key": "GET:/:va2=eq0",
      "status": 200,
      "headers": { "cf-ray": "abc124-SEA", "server": "cloudflare" },
      "body": "<html>Welcome to example.com</html>"
    },
    {
      "key": "GET:/:va2=eq1",
      "status": 200,
      "headers": { "cf-ray": "abc125-SEA", "server": "cloudflare" },
      "body": "<html>Welcome to example.com</html>"
    },
    {
      "key": "GET:/:va2=eq2",
      "status": 200,
      "headers": { "cf-ray": "abc126-SEA", "server": "cloudflare" },
      "body": "<html>Welcome to example.com</html>"
    },
    {
      "key": "GET:/:search=test",
